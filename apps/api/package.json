    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nexakabi/contracts": "workspace:*",
    "@nexakabi/utils": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/client-runtime-utils": "catalog:",
    "cloudinary": "catalog:",
    "cookie-parser": "catalog:",
    "dotenv": "catalog:",
    "helmet": "catalog:",
    "multer": "catalog:",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "nodemailer": "^10.0.1",
    "pdfkit": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
