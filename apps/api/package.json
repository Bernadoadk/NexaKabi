    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pdfkit": "catalog:",
    "@types/pg": "catalog:",
    "@types/qrcode": "catalog:",
