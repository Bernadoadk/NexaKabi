# Copier ce fichier vers .env et compléter.
# Toutes les variables sont validées au démarrage : une valeur manquante
# empêche le service de démarrer, volontairement.

NODE_ENV=development
PORT=4000

# PostgreSQL. Deux options : une instance locale, ou `pnpm infra:up` (Docker).
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/nexakabi_db"

# Connexion DIRECTE, sans pooler, pour le CLI Prisma (migrations) uniquement.
# Inutile en local. Chez Neon : DATABASE_URL = URL du pooler (hôte en
# `-pooler`), DATABASE_URL_UNPOOLED = même URL sans `-pooler`.
# DATABASE_URL_UNPOOLED=

# Origines autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:3000

API_PREFIX=api
LOG_LEVEL=debug
# Journaux lisibles (pino-pretty). Sans valeur : oui en développement, JSON
# ailleurs. À forcer à false sur Vercel, où le transport n'est pas embarqué.
# LOG_PRETTY=true
SWAGGER_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Tâches périodiques
# ─────────────────────────────────────────────────────────────────────────────
# in-process : le processus arme lui-même ses minuteries (@Cron). C'est le mode
#   d'un serveur qui tourne en continu — poste de développement, VPS.
# http : aucune minuterie. Un planificateur externe (cron-job.org, ou Vercel
#   Cron sur un plan payant) appelle GET /api/internal/cron/<tâche> avec
#   CRON_SECRET en jeton Bearer. Tâches et rythmes : docs/DEPLOYMENT.md §6.
SCHEDULER_MODE=in-process
# Obligatoire en mode http (32 caractères minimum) : openssl rand -base64 48.
# Vide en mode in-process = déclenchement externe fermé (403).
CRON_SECRET=

# Secrets — générer avec : openssl rand -base64 48
JWT_SECRET=remplacer-par-48-octets-aleatoires-openssl-rand-base64-48
OTP_PEPPER=remplacer-par-48-octets-aleatoires-openssl-rand-base64-48

# Signature des jetons d'acces a une commande en cours. DISTINCT de JWT_SECRET :
# un jeton de checkout est delivre sans authentification, il ne doit jamais
# pouvoir etre presente comme un jeton de session.
CHECKOUT_TOKEN_SECRET=remplacer-par-48-octets-aleatoires-openssl-rand-base64-48

# Les quatre secrets ci-dessus doivent etre DISTINCTS : la validation de
# demarrage refuse les doublons, et refuse en production toute valeur restee
# a son exemple.

# Envoi des codes à 6 chiffres. `console` écrit le code dans les journaux.
# Secret maître de signature des billets. Le changer invalide tous les QR émis.
TICKET_SIGNING_SECRET=change-moi-en-production-48-caracteres-aleatoires-minimum

SMS_PROVIDER=console

# ─────────────────────────────────────────────────────────────────────────────
# E-mail — billets, reçus, alertes
# ─────────────────────────────────────────────────────────────────────────────
# `console` écrit dans les journaux, même principe que SMS_PROVIDER : rien ne
# part vraiment tant que ce n'est pas passé à `smtp`.
EMAIL_PROVIDER=console

# Pour Gmail : smtp.gmail.com, port 587, SMTP_SECURE=false (STARTTLS).
# SMTP_USER = ton adresse Gmail complète.
# SMTP_PASSWORD = un mot de passe d'APPLICATION, jamais celui du compte :
#   1. Active la validation en deux étapes sur le compte Google
#   2. Génère le mot de passe sur https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nexa-Kabi <no-reply@nexakabi.bj>"

# ─────────────────────────────────────────────────────────────────────────────
# Bictorys — prestataire de paiement principal (carte + Mobile Money, multi-pays)
# ─────────────────────────────────────────────────────────────────────────────
# Laisser vide en développement : le simulateur prend alors la place du
# prestataire pour tous les moyens configurés, et tout le parcours reste
# testable — encaissement, remboursement, versement des retraits — avec les
# mêmes retours que le prestataire réel.
# Le NUMÉRO (du payeur à l'achat, du compte de réception au versement) choisit
# le scénario : finit par 00 → refus immédiat · 11 → jamais de réponse ·
# 22 → succès immédiat · autre → succès après quelques secondes.
# Un paiement par carte simulé ouvre une page où l'on valide ou refuse.
#
# Clés à récupérer sur le tableau de bord Bictorys, section Développeurs :
#   la clé d'API (test ou live selon l'environnement), le secret de webhook
#   (à créer, il arrive dans l'en-tête X-Secret-Key de chaque notification),
#   et le code secret marchand à 4 chiffres exigé pour les versements.
# Webhook à déclarer avec l'URL https://<votre-api>/api/webhooks/payments/bictorys
# Si BICTORYS_API_KEY est renseignée, BICTORYS_WEBHOOK_SECRET devient OBLIGATOIRE.
#
# Quels moyens sont ouverts dans quel pays ne se configure PAS ici : c'est la
# console d'administration (Pays & paiements), avec une synchronisation qui
# relit ce que le compte marchand sait réellement faire.
BICTORYS_ENVIRONMENT=test
BICTORYS_API_KEY=
BICTORYS_WEBHOOK_SECRET=
BICTORYS_PAYOUT_SECRET_CODE=

# ── KPay ──────────────────────────────────────────────────────────────────────
# Mobile Money au Bénin (MTN, Moov), en Côte d'Ivoire (MTN, Orange), au Sénégal
# (Orange, Free) et au Cameroun (MTN, Orange). Encaissement et versement.
#
# Pas de variable d'environnement : c'est le PRÉFIXE DE LA CLÉ qui décide si
# l'argent bouge. kpay_test_… simule (bac à sable), kpay_live_… débite pour de
# bon. L'API refuse de démarrer si le préfixe contredit NODE_ENV.
#
# Clés à récupérer sur le tableau de bord KPay, section Application :
#   la clé d'API (en-tête X-API-Key), la clé secrète (en-tête X-Secret-Key),
#   et le secret de webhook qui signe chaque notification en HMAC-SHA256.
# Webhook à déclarer avec l'URL https://<votre-api>/api/webhooks/payments/kpay
# Si KPAY_API_KEY est renseignée, KPAY_SECRET_KEY et KPAY_WEBHOOK_SECRET
# deviennent OBLIGATOIRES.
#
# La carte n'est PAS confiée à KPay : sa page hébergée facture en USD, alors
# qu'une commande Nexa-Kabi est un entier de francs CFA.
KPAY_API_URL=https://admin.kpay.site
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_WEBHOOK_SECRET=

# URL publique de l'API, telle que Bictorys la joint pour ses webhooks.
PUBLIC_API_URL=http://localhost:4000/api
# URL publique de l'application web, pour le retour d'un paiement par carte.
# Facultative : à défaut, la première origine de CORS_ORIGINS est utilisée.
# Le pare-feu de Bictorys REJETTE toute adresse de retour vers localhost : en
# local, les adresses de retour ne lui sont alors pas transmises (le Mobile
# Money fonctionne, la carte ne ramène pas l'acheteur toute seule). Pour tester
# la carte en local, expose le web par un tunnel et mets son adresse ici.
PUBLIC_WEB_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps Platform — clé SERVEUR
# ─────────────────────────────────────────────────────────────────────────────
# Sert à la recherche de lieux (Places API) et au géocodage, depuis l'API
# uniquement : elle ne quitte jamais le serveur. Dans la console Google Cloud,
# la restreindre par API (Places API (New), Geocoding API) et, en production,
# par adresse IP du serveur.
#
# Vide = la recherche de lieux est désactivée, la saisie manuelle reste possible.
GOOGLE_MAPS_SERVER_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudinary — stockage des visuels
# ─────────────────────────────────────────────────────────────────────────────
# Couvertures d'événement, plans du lieu, logos et bannières d'organisation,
# photos de profil, pièces de vérification. Les trois valeurs viennent du
# tableau de bord Cloudinary : https://console.cloudinary.com/ (Dashboard →
# Product Environment Credentials → Cloud name / API Key / API Secret).
#
# Les trois vont ensemble : renseigner l'une sans les autres empêche l'API de
# démarrer. Toutes les trois vides = stockage local de développement (voir
# storage.provider.ts) — interdit en production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
