# Copier vers .env.local pour un développement local.

# URL de base de l'API, côté serveur uniquement.
API_URL=http://localhost:4000/api

# Google Maps Platform — clé NAVIGATEUR
#
# Préfixe NEXT_PUBLIC_ : elle est livrée au navigateur, par construction — le
# SDK Maps JavaScript en a besoin pour afficher la carte. Ce n'est pas un
# secret : sa protection est la restriction par référent HTTP posée dans la
# console Google Cloud (localhost:3000/* en développement, le domaine public
# en production). Sans cette restriction, n'importe quel site pourrait la
# réutiliser et consommer votre quota.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# URL publique du site, sans barre oblique finale.
#
# Deux variables pour la même valeur, parce qu'elles ne vivent pas au même
# endroit : SITE_URL est lue au build par robots.ts et sitemap.ts, côté
# serveur ; NEXT_PUBLIC_SITE_URL est livrée au navigateur pour les liens de
# partage (billet, événement, kit de promotion). Les deux valent l'adresse
# à laquelle un participant ouvre le site — jamais l'URL de prévisualisation.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
