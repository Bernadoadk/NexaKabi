# Copier vers .env.local pour un développement local.

# URL de base de l'API, côté serveur uniquement.
#
# La console ne parle JAMAIS directement à l'API depuis le navigateur : elle
# passe par ses propres route handlers, qui portent le jeton dans un cookie
# httpOnly. Cette variable n'est donc jamais exposée au client.
API_URL=http://localhost:4000/api
