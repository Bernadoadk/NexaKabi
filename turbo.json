{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env.*local", "packages/config/**"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "prisma/schema.prisma"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@nexakabi/web#build": {
      "dependsOn": ["^build"],
      "env": ["API_URL", "SITE_URL", "NEXT_PUBLIC_SITE_URL", "NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@nexakabi/admin#build": {
      "dependsOn": ["^build"],
      "env": ["API_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
